# URL du backend Express (appels serveur→serveur via le BFF)
# En prod, pointer vers l'URL réelle du back.
BACKEND_URL=http://localhost:8000

# URL publique du backend, exposée au NAVIGATEUR (préfixe NEXT_PUBLIC_).
# Sert à construire le lien « Continuer avec Google », qui doit être une
# navigation pleine page vers le back — un fetch ne suivrait pas la redirection.
# N'y mettre aucun secret : cette valeur est inlinée dans le bundle client.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Clé API Mistral — utilisée UNIQUEMENT côté serveur (génération de tâches par IA).
# Ne jamais commiter de vraie valeur : renseigner dans .env.local.
MISTRAL_API_KEY=
